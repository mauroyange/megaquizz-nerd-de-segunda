{
  "name": "megaquizz-nerd-de-segunda",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:artifact": "vite build --config vite.artifact.config.ts && node scripts/make-artifact.mjs",
