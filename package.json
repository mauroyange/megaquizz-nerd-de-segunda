    "validate:questions": "vitest run src/data/questions.test.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/rubik": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.9"
  }
